# ─────────────────────────────────────────────────────────────
#  Prospection locale — variables d'environnement
#  Copiez ce fichier en `.env` puis complétez les valeurs.
# ─────────────────────────────────────────────────────────────

# Base de données (libSQL / SQLite).
#  - En local : un simple fichier SQLite
#  - En production : une base Turso (libsql://xxx.turso.io) + token
DATABASE_URL=file:./data/app.db
DATABASE_AUTH_TOKEN=

# Secret utilisé pour signer les sessions (32+ caractères aléatoires).
# Facultatif en développement, et en production avec une base Turso (une clé est alors
# dérivée du jeton de la base). Obligatoire en production sans Turso.
#  Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Inscription : le tout premier compte peut toujours être créé sur /inscription.
# Passez à true pour autoriser d'autres inscriptions (collègues…).
ALLOW_SIGNUP=false

# ── Sources de données ───────────────────────────────────────
# Clé Google Places API (New). Laissez vide pour utiliser OpenStreetMap (gratuit).
GOOGLE_PLACES_API_KEY=
# Nombre maximum d'appels Google par recherche (les grands rayons sont découpés en zones).
GOOGLE_MAX_CALLS_PER_SEARCH=12

# E-mail de contact transmis à OpenStreetMap (demandé par leur politique d'utilisation).
OSM_CONTACT_EMAIL=

# Serveurs OpenStreetMap (facultatif, des serveurs publics sont utilisés par défaut).
# Plusieurs serveurs Overpass séparés par des virgules : le suivant est essayé si l'un échoue.
# OVERPASS_URL=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
# NOMINATIM_URL=https://nominatim.openstreetmap.org
